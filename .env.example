# Скопіюй у .env і встав свої значення. Файл .env у .gitignore — не комітиться.

# ── Telegram ─────────────────────────────────────────────────────────────
# Токен бота від @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# Назва компанії (бренд, що бачить клієнт). За замовчуванням — демо «AutoRent».
COMPANY_NAME=AutoRent

# Операторська група (бот має бути адміном з правами «Керувати темами» +
# «Закріплювати повідомлення»). Дізнатись ID: команда /id у групі.
# Для груп ID від'ємний, напр. -1001234567890.
OPERATORS_CHAT_ID=

# Менеджери, яких бот @згадує на тривогах (user ID через кому).
# Дізнатись свій ID: команда /whoami у боті.
MANAGER_IDS=

# Підпис менеджера для клієнта (формат: id=Імʼя через кому).
# Задається ЯВНО, не береться з Telegram-профілю.
# напр.: MANAGER_NAMES=111111111=Олег,222222222=Марія
MANAGER_NAMES=

# Реальний телефон компанії для екстрених відповідей (ДТП). LLM номери не вигадує.
COMPANY_PHONE=+38 0XX XXX XXXX

# ── LLM (опційно) ────────────────────────────────────────────────────────
# Код OpenAI-сумісний: працює і з OpenRouter, і з ЛОКАЛЬНОЮ моделлю —
# змінюються лише LLM_BASE_URL + LLM_MODEL. Без жодного з них — бот rules-only.

# Базовий URL. За замовчуванням OpenRouter.
#   OpenRouter:  https://openrouter.ai/api/v1   (потрібен LLM_API_KEY)
#   Ollama:      http://localhost:11434/v1      (ключ не потрібен)
#   LM Studio:   http://localhost:1234/v1        (ключ не потрібен)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Ключ. Для OpenRouter — з https://openrouter.ai/keys. Для локальних — лишити порожнім.
LLM_API_KEY=

# Модель. Для OpenRouter — напр. meta-llama/llama-3.1-8b-instruct:free.
# Для локальних — назва витягнутої моделі, напр. llama3.1 / qwen2.5 тощо.
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
